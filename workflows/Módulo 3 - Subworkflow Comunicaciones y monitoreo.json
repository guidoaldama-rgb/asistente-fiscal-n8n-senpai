    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json;\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst n = Number(d.Dias_Restantes);\n\nfunction plazo(dias) {\n  if (dias < 0) return `venció hace ${Math.abs(dias)} día${Math.abs(dias) === 1 ? '' : 's'}`;\n  if (dias === 0) return 'vence hoy';\n  if (dias === 1) return 'vence mañana';\n  return `vence en ${dias} días`;\n}\n\nconst rs = esc(d.Razon_Social);\nconst imp = esc(d.Impuestos_A_Liquidar);\nconst cons = esc(d.Consultor);\nlet asunto, cuerpo;\n\nif (d.Nivel_Alerta === 'VENCIDO') {\n  asunto = `URGENTE: vencimiento fiscal vencido - ${d.Razon_Social}`;\n  cuerpo = `<p>Estimados <b>${rs}</b>:</p>\n<p>El vencimiento para liquidar <b>${imp}</b> ${plazo(n)} y todavía no recibimos su documentación.</p>\n<p>Cada día de atraso puede generar <b>multas y recargos</b>. Les pedimos enviar hoy mismo las facturas de compras y ventas del período a su consultor, ${cons}, para regularizar la situación cuanto antes.</p>`;\n} else if (d.Nivel_Alerta === 'CRITICO') {\n  asunto = `Atención: su vencimiento fiscal ${plazo(n)} - ${d.Razon_Social}`;\n  cuerpo = `<p>Estimados <b>${rs}</b>:</p>\n<p>Su vencimiento para liquidar <b>${imp}</b> <b>${plazo(n)}</b> y aún tenemos documentación pendiente.</p>\n<p>Para presentar en fecha necesitamos recibirla a la brevedad. Pueden enviarla a su consultor, ${cons}.</p>`;\n} else if (d.Nivel_Alerta === 'PREVENTIVO') {\n  asunto = `Recordatorio: próximo vencimiento fiscal - ${d.Razon_Social}`;\n  cuerpo = `<p>Estimados <b>${rs}</b>:</p>\n<p>Les recordamos que su vencimiento para liquidar <b>${imp}</b> ${plazo(n)}.</p>\n<p>Para preparar la declaración con tiempo, les agradecemos enviar las facturas de compras y ventas del período a su consultor, ${cons}.</p>`;\n} else {\n  asunto = `Recordatorio de vencimiento fiscal - ${d.Razon_Social}`;\n  cuerpo = `<p>Estimados <b>${rs}</b>:</p>\n<p>Les recordamos que su vencimiento para liquidar <b>${imp}</b> ${plazo(n)}.</p>\n<p>Ante cualquier consulta, pueden comunicarse con su consultor, ${cons}.</p>`;\n}\n\ncuerpo += `<p>Saludos cordiales,<br>${cons}<br>Departamento de Impuestos</p>`;\nreturn { json: { ...d, Asunto: asunto, Cuerpo: cuerpo } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
