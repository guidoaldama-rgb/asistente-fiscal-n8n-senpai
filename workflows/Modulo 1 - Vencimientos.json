    {
      "parameters": {
        "jsCode": "const hoyUTC = Date.UTC($now.year, $now.month - 1, $now.day);\nconst hoyTexto = $now.toFormat('dd/MM/yyyy');\nconst NIVELES_CON_AVISO = ['VENCIDO', 'CRITICO', 'URGENTE_INTERNO', 'PREVENTIVO'];\nconst REPETIR_CADA_DIAS = { VENCIDO: 3 };\n\nfunction parsearFecha(valor) {\n  if (valor === undefined || valor === null || valor === '') return null;\n  if (typeof valor === 'number') return Date.UTC(1899, 11, 30) + Math.round(valor) * 86400000;\n  const t = String(valor).trim();\n  let m = t.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})/);\n  if (m) return Date.UTC(+m[3], +m[2] - 1, +m[1]);\n  m = t.match(/^(\\d{4})-(\\d{1,2})-(\\d{1,2})/);\n  if (m) return Date.UTC(+m[1], +m[2] - 1, +m[3]);\n  return null;\n}\n\nreturn $input.all().map(item => {\n  const data = item.json;\n\n  const fechaVencUTC = parsearFecha(data.Fecha_Vencimiento);\n  if (fechaVencUTC === null) {\n    throw new Error(`Fecha_Vencimiento inválida para ${data.Razon_Social}: \"${data.Fecha_Vencimiento}\"`);\n  }\n  const diasRestantes = Math.round((fechaVencUTC - hoyUTC) / 86400000);\n\n  let nivelAlerta = 'NORMAL';\n  let accionSugerida = 'Sin acción inmediata';\n\n  if (data.Estado_DJ === 'Presentada') {\n    nivelAlerta = 'COMPLETADO';\n    accionSugerida = 'Declaración Jurada ya presentada';\n  } else if (diasRestantes < 0 && data.Estado_Doc === 'Pendiente') {\n    nivelAlerta = 'VENCIDO';\n    accionSugerida = 'Escalar urgente a Gerente de Impuestos (riesgo de multas y recargos)';\n  } else if (diasRestantes < 0) {\n    nivelAlerta = 'URGENTE_INTERNO';\n    accionSugerida = 'DJ vencida con documentación ya en el estudio: presentar de inmediato y escalar al Gerente de Impuestos';\n  } else if (diasRestantes <= 2 && data.Estado_Doc === 'Pendiente') {\n    nivelAlerta = 'CRITICO';\n    accionSugerida = 'Intimar documentación al cliente y alertar al equipo';\n  } else if (diasRestantes <= 2) {\n    nivelAlerta = 'URGENTE_INTERNO';\n    accionSugerida = 'Documentación en estudio: apurar cierre y envío de DJ';\n  } else if (diasRestantes <= 5 && data.Estado_Doc === 'Pendiente') {\n    nivelAlerta = 'PREVENTIVO';\n    accionSugerida = 'Enviar recordatorio solicitando información';\n  }\n\n  // Clave del aviso: nivel + vencimiento.\n  // Si la DJ ya venció con la documentación en el estudio, la clave cambia\n  // para que el equipo reciba una alerta nueva aunque el nivel siga siendo URGENTE_INTERNO.\n  const vencTexto = new Date(fechaVencUTC).toISOString().slice(0, 10);\n  const sufijo = (nivelAlerta === 'URGENTE_INTERNO' && diasRestantes < 0) ? '_VENCIDA' : '';\n  const claveActual = `${nivelAlerta}${sufijo} ${vencTexto}`;\n\n  const ultimoAvisoUTC = parsearFecha(data.Ultimo_Aviso);\n  const diasDesdeAviso = ultimoAvisoUTC === null ? null : Math.round((hoyUTC - ultimoAvisoUTC) / 86400000);\n\n  let debeAvisar = false;\n  if (NIVELES_CON_AVISO.includes(nivelAlerta)) {\n    if (diasDesdeAviso === null) debeAvisar = true;\n    else if (diasDesdeAviso <= 0) debeAvisar = false;\n    else if (String(data.Aviso_Registrado || '') !== claveActual) debeAvisar = true;\n    else if (REPETIR_CADA_DIAS[nivelAlerta] && diasDesdeAviso >= REPETIR_CADA_DIAS[nivelAlerta]) debeAvisar = true;\n  }\n\n  return {\n    json: {\n      ...data,\n      Dias_Restantes: diasRestantes,\n      Nivel_Alerta: nivelAlerta,\n      Accion_Sugerida: accionSugerida,\n      Debe_Avisar: debeAvisar,\n      Ultimo_Aviso: debeAvisar ? hoyTexto : (data.Ultimo_Aviso ?? ''),\n      Aviso_Registrado: debeAvisar ? claveActual : (data.Aviso_Registrado ?? ''),\n      Fecha_Proceso: $now.toISO()\n    }\n  };\n});"
      },
