    {
      "parameters": {
        "jsCode": "function parsearFecha(valor) {\n  if (valor === undefined || valor === null || valor === '') return null;\n  if (typeof valor === 'number') return Date.UTC(1899, 11, 30) + Math.round(valor) * 86400000;\n  const t = String(valor).trim();\n  let m = t.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})/);\n  if (m) return Date.UTC(+m[3], +m[2] - 1, +m[1]);\n  m = t.match(/^(\\d{4})-(\\d{1,2})-(\\d{1,2})/);\n  if (m) return Date.UTC(+m[1], +m[2] - 1, +m[3]);\n  return null;\n}\n\nconst vigentes = $input.all().filter(item => {\n  const f = parsearFecha(item.json.Fecha_Vencimiento);\n  if (f === null) return false;\n  const d = new Date(f);\n  return d.getUTCFullYear() === $now.year && d.getUTCMonth() + 1 === $now.month;\n});\n\nif (vigentes.length === 0) {\n  throw new Error(`No hay vencimientos cargados en Calendario_Fiscal para ${$now.toFormat('MM/yyyy')}`);\n}\nreturn vigentes;"
      },
